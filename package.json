{
  "name": "devmedic",
  "version": "0.1.0",
  "description": "Self-healing CLI agent: detects failing integration tests, analyzes the stack trace, patches the code and re-runs until green.",
  "type": "module",
  "bin": {
    "devmedic": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "npm run build && node scripts/demo.mjs",
    "start": "node dist/index.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "execa": "^10.0.1",
    "picocolors": "^1.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
